{
  "extends": "./app/node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "paths": {
      "@/*": [
        "./app/src/*"
      ],
      "@/assets/*": [
        "./app/assets/*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/.expo/types/**/*.ts",
    "app/expo-env.d.ts",
    "app/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/node_modules/**",
    "admin-web",
    "backend"
  ]
}
